# Telegram (can reuse the concerts-bot token; chat id = your numeric id)
TELEGRAM_BOT_TOKEN=...
TELEGRAM_CHAT_ID=...

# Alert when the cheapest card of a value costs at most this % above face value,
# after fees and conversion to ILS. Keyshops usually sit at +35-60%, so 15 = "near face value / restock".
MAX_MARKUP_PCT=15
# Israeli credit card foreign-transaction fee (check your bank; Max/Isracard/Cal are usually 2.5-3%)
FOREIGN_FEE_PCT=2.5
# Estimated checkout fees for stores whose listed price excludes them
SEAGM_FEE_PCT=3
ENEBA_FEE_PCT=11

# Card values (INR) you care about
DENOMINATIONS=500,1000,1500,2000,2500,3000,4000,5000,7000,8000

# Optional: Amazon.in via the Keepa API (paid, https://keepa.com/#!api). Amazon blocks direct scraping.
# AMAZON_ASINS maps card value to Amazon.in ASIN, e.g. 1000:B0XXXXXXX,2000:B0YYYYYYY
KEEPA_API_KEY=
AMAZON_ASINS=

DATABASE_PATH=./data/scout.db
TIMEZONE=Asia/Jerusalem
LOG_LEVEL=INFO
